  "dialogues": [
    {
      "id": "d-c3-gramophone",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tiếng nhạc bolero du dương trên chiếc máy hát đĩa than, nhưng ngoài cửa tiệm rình rập những âm mưu chiếm đoạt."
        }
      ]
    },
    {
      "id": "d-c3-street-exit",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Phố xá Đa Kao nhộn nhịp, mình phải đến tận sào huyệt của thầy Ba Càn tìm cho ra cuốn sổ tử vi gốc."
        }
      ]
    },
    {
      "id": "d-c3-incense-smoke",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Mùi khói nhang thuốc bắc ngột ngạt bao trùm căn phòng bói toán lừa bịp."
        }
      ]
    },
    {
      "id": "d-c3-bagua",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Đường may raglan ráp xéo 45 độ từ cổ xuống nách ứng với quẻ Tốn (Đông Nam) và quẻ Càn (Tây Bắc) trên gương bát quái!",
          "clueId": "clue-bagua-hint"
        }
      ]
    },
    {
      "id": "d-c3-mua-chuoc",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tờ biên nhận 2000 đồng của bà Hội đồng thuê vu khống gò má cao sát phu!",
          "clueId": "clue-mua-chuoc-thay-boi"
        }
      ]
    },
    {
      "id": "d-c3-so-tu-vi",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Giờ sinh thật của Vinh là giờ Thìn đại cát, thầy bói đã tráo thành giờ Dần để lừa đảo.",
          "clueId": "clue-so-tu-vi-goc"
        }
      ]
    },
    {
      "id": "d-c3-thoa-thuan",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Bức thư tay thỏa thuận ép tôi làm vợ lẽ đi cửa sau để cướp trắng căn nhà tiệm may Đa Kao!",
          "clueId": "clue-thoa-thuan-boi-toan"
        }
      ]
    },
    {
      "id": "d-c3-vinh-stand",
      "speaker": "Vinh",
      "nodes": [
        {
          "id": "node-1",
          "text": "Mai ơi, anh sẽ rời khỏi dinh thự này để cùng em xây dựng hạnh phúc bằng lao động chân chính!"
        }
      ]
    },
    {
      "id": "d-c3-ong-le-defeat",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Gò má cao là nụ cười kiêu hãnh của phụ nữ tự chủ, không phải cái cớ để các người ép làm lẽ!"
        }
      ]
    }
  ],
