  "dialogues": [
    {
      "id": "d-c2-ca-nghi",
      "speaker": "Ông Cả Nghị",
      "nodes": [
        {
          "id": "node-1",
          "text": "Nữ nhi vô tài tiện thị đức! Ngày mai cô phải gật đầu làm kế thất quan Huyện để trừ món nợ 500 đồng!"
        }
      ]
    },
    {
      "id": "d-c2-mat-ma",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Góc tà áo có dòng chữ chì than: 'Giao kèo bán tạ - Hòm sắt tiệm vải Hàng Đào - Chìa giấu sau đồng hồ quả lắc'.",
          "clueId": "clue-ban-ve-lemur-mat-ma"
        }
      ]
    },
    {
      "id": "d-c2-silk-shelves",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Những súc lụa Hà Đông, the, sa cao cấp xếp tầng trên kệ, nhưng sự dối trá nằm trong chiếc két sắt góc phòng."
        }
      ]
    },
    {
      "id": "d-c2-bien-lai",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Khoản nợ 500 đồng của cha tôi thực chất đã được thanh toán hết từ sáu tháng trước!",
          "clueId": "clue-bien-lai-goc-1935"
        }
      ]
    },
    {
      "id": "d-c2-giao-keo",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Ông Cả Nghị đã cố tình ỉm biên lai để ép tôi làm vợ kế quan Huyện nhằm độc quyền thầu vải sợi.",
          "clueId": "clue-giao-keo-ep-hon"
        }
      ]
    }
  ],
