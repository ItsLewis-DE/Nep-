  "dialogues": [
    {
      "id": "d-c4-nam-1845",
      "speaker": "Cô Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Trên xà nóc có khắc chữ Hán: 'Ất Tỵ niên chế - 1845', năm cụ tổ dựng nên từ đường!",
          "clueId": "clue-nam-1845"
        }
      ]
    },
    {
      "id": "d-c4-altar-incense",
      "speaker": "Cô Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Bàn thờ tổ uy nghiêm chứng giám cho lòng hiếu thảo của bao thế hệ con cháu."
        }
      ]
    },
    {
      "id": "d-c4-ao-cuoi",
      "speaker": "Cô Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Chiếc áo dài phin trắng thêu cành đào nhỏ may từ tem phiếu khen thưởng lao động tiên tiến!",
          "clueId": "clue-ao-cuoi-vai-phin"
        }
      ]
    },
    {
      "id": "d-c4-cong-duc",
      "speaker": "Cô Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cụ Loan dốc cạn bạc vàng dệt vải cứu đói năm 1945, mẹ Mai phụng dưỡng từ đường qua chiến tranh!",
          "clueId": "clue-cong-duc-cu-loan-ba-mai"
        }
      ]
    },
    {
      "id": "d-c4-uncle-suu",
      "speaker": "Chú Sửu",
      "nodes": [
        {
          "id": "node-1",
          "text": "Nhất nam viết hữu, thập nữ viết vô! Con gái đi lấy chồng thì không có quyền lên tiếng về đất tổ!"
        }
      ]
    },
    {
      "id": "d-c4-patriarch-defeat",
      "speaker": "Cô Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Con gái hay con trai đều là máu mủ cha ông, đều cống hiến cho đất nước và gia đình!"
        }
      ]
    }
  ],
