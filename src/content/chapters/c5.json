  "dialogues": [
    {
      "id": "d-c5-cat-audio",
      "speaker": "Băng ghi âm Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Nếp áo không sợ thời gian, nếp áo chỉ sợ lòng người quên mất gốc rễ. Hãy thấu hiểu nỗi đau để thấy sức mạnh tiền nhân."
        }
      ]
    },
    {
      "id": "d-c5-livestream",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Phiên livestream rao bán áo ngũ thân nhái may vải nilon rẻ tiền, cắt cúp sai lệch lịch sử để câu view!",
          "clueId": "clue-ao-nhai-livestream"
        }
      ]
    },
    {
      "id": "d-c5-stairway",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Gió thu thổi bùng căn gác xép, chiếc rương gia bảo đang phát sáng triệu hồi sức mạnh 5 thế hệ."
        }
      ]
    },
    {
      "id": "d-c5-cam-spirit",
      "speaker": "Cụ Cầm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Nếp áo Vạn Phúc của cụ gửi trao sự cần cù và tự do bất khuất!"
        }
      ]
    },
    {
      "id": "d-c5-loan-spirit",
      "speaker": "Cụ Loan",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tà áo tân thời của cụ mang theo tri thức và lòng kiên định không khuất phục!"
        }
      ]
    },
    {
      "id": "d-c5-mai-spirit",
      "speaker": "Bà Mai",
      "nodes": [
        {
          "id": "node-1",
          "text": "Đường may raglan của bà là nụ cười kiêu hãnh của phụ nữ tự chủ giữa phố thị!"
        }
      ]
    },
    {
      "id": "d-c5-phuong-spirit",
      "speaker": "Mẹ Phương",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cành hoa đào của mẹ đượm tình người và lòng thủy chung son sắt qua năm tháng khó khăn!"
        }
      ]
    },
    {
      "id": "d-c5-an-center",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Cháu sẽ kết nối 5 ngọn lửa tiền nhân để hồi sinh trọn vẹn tà áo Việt!"
        }
      ]
    },
    {
      "id": "d-c5-ho-so",
      "speaker": "An",
      "nodes": [
        {
          "id": "node-1",
          "text": "Hồ sơ giám định chỉ rõ 3 điểm sai phạm: nút bấm kim loại Tây, thiếu vạt con che chở, vải nilon dễ cháy!",
          "clueId": "clue-ho-so-giam-dinh-2026"
        }
      ]
    },
    {
      "id": "d-c5-lam-apology",
      "speaker": "Hoàng Lâm",
      "nodes": [
        {
          "id": "node-1",
          "text": "Tôi xin lỗi công chúng... Tôi đã sai khi xem nhẹ chiều sâu văn hóa truyền thống của tà áo dân tộc."
        }
      ]
    }
  ],
